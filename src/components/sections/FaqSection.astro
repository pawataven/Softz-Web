---
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<section class="section" id="faq" aria-labelledby="faq-heading">
  <div class="container-page page-grid faq">
    <SectionHeading label="FAQ" heading="คำถามที่พบบ่อย" sub="ข้อสงสัยที่ลูกค้าถามเราบ่อยที่สุด" id="faq-heading" />
    <div class="reveal">
      {
        items.map((item) => (
          <details name="faq">
            <summary>
              <h3>{item.question}</h3>
              <span class="pm" aria-hidden="true" />
            </summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>

  <script>
    import '../../scripts/faq';
  </script>
</section>
