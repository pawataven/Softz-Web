---
import { CONTACT } from '../../../config/site';
import { ROUTES } from '../../../config/routes';
import { lineMessageUrl } from '../../../lib/line';
import { getProducts } from '../../../lib/products';
import Icon from '../../ui/Icon.astro';

const products = await getProducts();

const budgetOptions = ['ไม่เกิน 10,000 บาท', '10,000–30,000 บาท', '30,000–60,000 บาท', 'มากกว่า 60,000 บาท', 'รายเดือน', 'ยังไม่แน่ใจ'];
const startOptions = ['ภายในเดือนนี้', '1–3 เดือน', 'มากกว่า 3 เดือน', 'แค่หาข้อมูล'];
---

<div class="panel reveal">
  <form class="form" data-brief novalidate>
    <div class="form-grid">
      <div class="field">
        <label for="brief-name">ชื่อ-นามสกุล *</label>
        <input id="brief-name" name="name" required autocomplete="name" aria-describedby="brief-name-error" />
        <p class="msg" id="brief-name-error">กรอกชื่อ</p>
      </div>
      <div class="field">
        <label for="brief-business">ชื่อธุรกิจ</label>
        <input id="brief-business" name="business" autocomplete="organization" />
      </div>
      <div class="field">
        <label for="brief-phone">เบอร์โทร *</label>
        <input
          id="brief-phone"
          name="phone"
          type="tel"
          required
          inputmode="tel"
          autocomplete="tel"
          placeholder="08x xxx xxxx"
          aria-describedby="brief-phone-error"
        />
        <p class="msg" id="brief-phone-error">กรอกเบอร์โทร 9–10 หลัก</p>
      </div>
      <div class="field">
        <label for="brief-email">อีเมล</label>
        <input id="brief-email" name="email" type="email" autocomplete="email" aria-describedby="brief-email-error" />
        <p class="msg" id="brief-email-error">รูปแบบอีเมลไม่ถูกต้อง</p>
      </div>
      <fieldset class="field full">
        <legend class="fl">สนใจเรื่องไหน (เลือกได้หลายข้อ)</legend>
        <div class="chips-pick">
          {
            products.map((product) => (
              <label>
                <input type="checkbox" name="interest" value={product.id} />
                <span>{product.data.navLabel}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <div class="field">
        <label for="brief-budget">งบประมาณ</label>
        <select id="brief-budget" name="budget">
          <option value="">เลือก</option>
          {budgetOptions.map((option) => <option>{option}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="brief-start">อยากเริ่มเมื่อไหร่</label>
        <select id="brief-start" name="start">
          <option value="">เลือก</option>
          {startOptions.map((option) => <option>{option}</option>)}
        </select>
      </div>
      <div class="field full">
        <label for="brief-detail">เล่าเรื่องงานสั้นๆ</label>
        <textarea id="brief-detail" name="detail" placeholder="เช่น ร้านคาเฟ่ 2 สาขา อยากได้เว็บพร้อมระบบรับจองโต๊ะ"></textarea>
      </div>
      <label class="consent full">
        <input type="checkbox" name="consent" required />
        <span>
          ยินยอมให้ SOFT Z DIGITAL เก็บและใช้ข้อมูลนี้เพื่อติดต่อกลับเท่านั้น
          <a href={ROUTES.privacy} target="_blank">อ่านนโยบายความเป็นส่วนตัว</a>
        </span>
      </label>
    </div>
    <div class="form-foot">
      <small>หรือทักแชท LINE {CONTACT.lineId}</small>
      <button class="btn btn-primary" type="submit">ส่งข้อมูล</button>
    </div>
  </form>

  <div class="thanks" data-thanks role="status" aria-live="polite">
    <div class="ok"><Icon name="check" size={22} /></div>
    <h3>Thank you.</h3>
    <p data-thanks-sent hidden>ได้รับข้อมูลแล้ว ทีมจะติดต่อกลับภายใน 1 วันทำการ</p>
    <p data-thanks-pending>กดส่งต่อทาง LINE ด้านล่าง เพื่อให้ทีมได้รับรายละเอียดและติดต่อกลับภายใน 1 วันทำการ</p>
    <div class="btn-row">
      <a class="btn btn-primary" href={lineMessageUrl('ส่งรายละเอียดงานครับ')} data-thanks-line target="_blank" rel="noopener">
        <Icon name="line" size={16} />ส่งต่อทาง LINE
      </a>
      <button class="btn btn-glass" type="button" data-again>ส่งอีกครั้ง</button>
    </div>
  </div>

  <script>
    import '../../../scripts/brief-form';
  </script>
</div>

