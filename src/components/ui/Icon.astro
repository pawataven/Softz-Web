export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
}

const { name, size } = Astro.props;
const icon: { viewBox: string; body: string; fill?: boolean; strokeWidth?: number; round?: boolean } = icons[name];
const paintAttributes = icon.fill
  ? { fill: 'currentColor' }
  : {
      fill: 'none',
      stroke: 'currentColor',
      'stroke-width': icon.strokeWidth,
      ...(icon.round && { 'stroke-linecap': 'round' as const, 'stroke-linejoin': 'round' as const }),
    };
---

<svg viewBox={icon.viewBox} width={size} height={size} aria-hidden="true" focusable="false" {...paintAttributes} set:html={icon.body} />
