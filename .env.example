# Production domain, no trailing slash. Drives canonical URLs, Open Graph URLs, sitemap and robots.txt.
SITE_URL=https://www.example.com

# Set to true ONLY on the production deployment. Staging/preview builds stay noindex and robots.txt disallows everything.
PUBLIC_ALLOW_INDEXING=false

# Optional: URL that receives the contact-page brief as JSON (POST). Without it, the form hands the brief off to LINE.
# PUBLIC_BRIEF_ENDPOINT=https://example.com/api/brief
